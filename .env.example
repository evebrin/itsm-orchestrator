# itsm-orchestrator settings. Copy to .env (gitignored) and fill in. Values are never printed or logged.
# The shared PDI (ADR 0001). Personal Developer Instances only.
SN_INSTANCE_URL=https://devNNNNNN.service-now.com
# Admin: setup, seed, teardown, probes' temporary users, metadata reads. Never used by an agent at runtime.
SN_ADMIN_USER=admin
SN_ADMIN_PASSWORD=replace-me
# Runtime identities, one per duty (END_TO_END_ITSM.md §5.2). Created in phase 2; not needed for phase 1 probes.
SN_INCIDENT_USER=syn.svc.e2e_incident
SN_INCIDENT_PASSWORD=replace-me
SN_PROBLEM_USER=syn.svc.e2e_problem
SN_PROBLEM_PASSWORD=replace-me
SN_CHANGE_USER=syn.svc.change_agents
SN_CHANGE_PASSWORD=replace-me
SN_APPROVER_USER=syn.svc.e2e_approver
SN_APPROVER_PASSWORD=replace-me
# One LLM provider (ADR 0008).
XAI_API_KEY=replace-me
XAI_MODEL=replace-me
# Demo-only human gates (§6). Leave empty.
DEMO_HUMAN_GATES=
